# ====================== Auth Service ======================
AUTH_DB_HOST=postgres-auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=postgres123
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres-auth:5432/auth_db

# ====================== Redis ======================
REDIS_HOST=redis-app
REDIS_PORT=6379
REDIS_URL=redis://redis-app:6379/0

# ====================== JWT (общий секрет для auth-service и api-gateway) ======================
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ====================== OTP ======================
SMS_RU_API_ID=your-sms-ru-api-id
OTP_TTL_SECONDS=300

# ====================== Activity Service ======================
ACTIVITY_DB_HOST=postgres-activity
ACTIVITY_DB_PORT=5432
ACTIVITY_DB_NAME=activity_db
ACTIVITY_DB_USER=postgres
ACTIVITY_DB_PASSWORD=postgres123
ACTIVITY_DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres-activity:5432/activity_db

# ====================== Chat Service ======================
CHAT_DB_HOST=postgres-chat
CHAT_DB_PORT=5432
CHAT_DB_NAME=chat_db
CHAT_DB_USER=postgres
CHAT_DB_PASSWORD=postgres123
CHAT_DATABASE_URL=postgresql+asyncpg://postgres:postgres123@postgres-chat:5432/chat_db

# ====================== Kafka ======================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ====================== MinIO ======================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://192.168.0.124:9000

# ====================== Internal service URLs (для api-gateway) ======================
ACTIVITY_SERVICE_URL=http://activity-service:8000
AUTH_SERVICE_URL=http://auth-service:8000
CHAT_SERVICE_URL=http://chat-service:8000
MEDIA_SERVICE_URL=http://media-service:8000
USER_SERVICE_URL=http://user-service:8000
