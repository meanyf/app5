# --- JWT ---
JWT_SECRET=your_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=30

# --- SMS.RU ---
SMSRU_API_KEY=your_smsru_api_key

# --- OTP ---
OTP_TTL_SECONDS=300

# --- Databases ---
AUTH_DB_URL=postgresql+asyncpg://auth_user:auth_pass@pgbouncer:5432/auth_db
USERS_DB_URL=postgresql+asyncpg://users_user:users_pass@pgbouncer:5432/users_db
ACTIVITIES_DB_URL=postgresql+asyncpg://activities_user:activities_pass@pgbouncer:5432/activities_db
CHAT_DB_URL=postgresql+asyncpg://chat_user:chat_pass@pgbouncer:5432/chat_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=media

# --- FCM ---
FCM_SERVER_KEY=your_fcm_server_key

# --- Rate Limiting ---
RATE_LIMIT_ACTIVITIES_PER_DAY=10

# --- Service URLs (internal) ---
AUTH_SERVICE_URL=http://auth-service:8000
USER_SERVICE_URL=http://user-service:8000
ACTIVITY_SERVICE_URL=http://activity-service:8000
MEDIA_SERVICE_URL=http://media-service:8000
CHAT_SERVICE_URL=http://chat-service:8000
